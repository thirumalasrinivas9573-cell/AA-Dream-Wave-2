# ── Frontend Environment Variables ────────────────────────────────────────────
# Local: copy to .env.local (gitignored via *.local)
# Netlify: Site settings → Environment variables (Production context)
#
# IMPORTANT (Vite):
# - Every client-exposed var MUST start with VITE_
# - Do NOT wrap values in quotes in the Netlify UI
# - Never put Firebase Admin / service-account keys here

# Required in production: absolute backend API base ending in /api
VITE_API_URL=https://YOUR-SERVICE-NAME.onrender.com/api

# Optional display name
VITE_APP_NAME=Dream Wave AI

# Firebase Web App (AA Dream Wave) — browser-safe config only
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
