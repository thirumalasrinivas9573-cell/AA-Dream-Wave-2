# Dream Wave — Environment Variables (Frontend)
# Copy to .env.local for local development. Never commit secrets.

# -----------------------------------------------------------------------------
# Application (public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Dream Wave
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
# Production: NEXT_PUBLIC_APP_ENV=production
# Production: NEXT_PUBLIC_APP_URL=https://your-domain.example
# Production: NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example/api

# -----------------------------------------------------------------------------
# API (public base URL only — prepared for future integration)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api

# Institution browser demo seeds (false = live mode, empty until backend APIs land)
NEXT_PUBLIC_INSTITUTION_DEMO_DATA=false

# -----------------------------------------------------------------------------
# Feature flags (public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_THREE_JS=true

# -----------------------------------------------------------------------------
# Future authentication (server-only placeholders — do not expose to client)
# -----------------------------------------------------------------------------
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Future analytics (server-only placeholders)
# -----------------------------------------------------------------------------
# ANALYTICS_WRITE_KEY=
# ANALYTICS_APP_ID=

# -----------------------------------------------------------------------------
# Future third-party (server-only placeholders)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# STRIPE_SECRET_KEY=
