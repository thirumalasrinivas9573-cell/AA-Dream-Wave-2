# ── Backend Environment Variables ─────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/dreamwave?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-64-char-random-hex
AUTH_CHALLENGE_SECRET=replace-with-a-different-64-char-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MS=2592000000
JWT_REFRESH_TTL_SHORT_MS=86400000
REFRESH_COOKIE_NAME=dw_refresh
COOKIE_REFRESH_ONLY=true
# Auth lockout: 5 failed logins → 15 minute lock (server constants)

# AI Services (Google Gemini API)
GEMINI_API_KEY=AIzaSy...
# Supported models: gemini-flash-latest, gemini-3.1-flash-lite, gemini-3.5-flash
GEMINI_MODEL=gemini-flash-latest
# Optional custom base URL (default: Google's official OpenAI-compatible endpoint)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Frontend CORS
CLIENT_URL=https://YOUR-SITE.netlify.app
# Comma-separated extra origins (e.g. Netlify previews)
EXTRA_CORS_ORIGINS=
TRUST_PROXY=true
# Absolute public site URL used in XML sitemaps / SEO
PUBLIC_APP_URL=https://dreamwave.ai

# ── Production Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Dream Wave AI <noreply@dreamwave.ai>
# Until your domain is verified on Resend, use:
# EMAIL_FROM=Dream Wave AI <onboarding@resend.dev>

# ── Production Mobile OTP (Twilio Verify) ─────────────────────────────────────
# Create a Verify Service in Twilio Console → Verify → Services
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional legacy (NOT used for OTP — Verify API only):
# TWILIO_FROM_NUMBER=+1234567890

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Optional additional service-to-service protection for /api/mj
MJ_API_KEY=
